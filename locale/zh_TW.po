#. The default primary button label used in alert dialogs.
msgctxt "alert"
msgid "Okay"
msgstr ""

#. The default secondary/cancel button label used in alert dialogs.
msgctxt "alert"
msgid "Cancel"
msgstr ""

#. The title of the error dialog shown when platform initialization fails (e.g. Steam).
msgid "Startup Error"
msgstr ""

#. The message shown when Steam fails to initialize, advising the player to check that Steam is running.
msgid ""
"Steam could not be initialized. Please make sure Steam is running and "
"restart the game."
msgstr ""

#. Used as a category name for a group of input actions related to menu navigation.
msgctxt "action_sets"
msgid "Menus"
msgstr ""

#. An input action that confirms the current selection.
msgctxt "actions_Menu"
msgid "Accept"
msgstr ""

#. An input action used to cancel the current selection/leave the current menu page.
msgctxt "actions_Menu"
msgid "Cancel"
msgstr ""

#. An input action used to navigate left within a game menu.
msgctxt "actions_Menu"
msgid "Left"
msgstr ""

#. An input action used to navigate right within a game menu.
msgctxt "actions_Menu"
msgid "Right"
msgstr ""

#. An input action used to navigate up within a game menu.
msgctxt "actions_Menu"
msgid "Up"
msgstr ""

#. An input action used to navigate down within a game menu.
msgctxt "actions_Menu"
msgid "Down"
msgstr ""

#. An input action used to navigate to the next item within a game menu.
msgctxt "actions_Menu"
msgid "Next"
msgstr ""

#. An input action used to navigate to the previous item within a game menu.
msgctxt "actions_Menu"
msgid "Previous"
msgstr ""

#. Used as a category name for a group of input actions related to splash screens.
msgctxt "action_sets"
msgid "Splash"
msgstr ""

#. The accept input action, which skips a splash screen.
msgctxt "actions_Splash"
msgid "Accept"
msgstr ""

#. The cancel input action, which skips a splash screen.
msgctxt "actions_Splash"
msgid "Cancel"
msgstr ""

#. Used as a category name for a group of input actions related to the options menu.
msgctxt "action_sets"
msgid "Menu options"
msgstr ""

#. An input action that opens or closes a game menu, such as the pause or options menu.
msgctxt "actions_MenuOptions"
msgid "Menu"
msgstr ""

#. Used as a category name for a group of input actions related to changing tabs in a tabbed menu.
msgctxt "action_sets"
msgid "Menu tabs"
msgstr ""

#. An input action that moves to the next tab/page within a game menu.
msgctxt "actions_MenuTabbed"
msgid "Next tab"
msgstr ""

#. An input action that moves to the previous tab/page within a game menu.
msgctxt "actions_MenuTabbed"
msgid "Previous tab"
msgstr ""

#. Used as a category name for a group of input actions related to changing which game actions are bound to a controller input button.
msgctxt "action_sets"
msgid "Input binding"
msgstr ""

#. An input action that cancels the "rebinding" operation.
msgctxt "actions_MenuBinding"
msgid "Cancel binding"
msgstr ""

#. A button to open the options menu, located on the pause menu.
msgid "Options"
msgstr ""

#. A button to quit/exit the game, located on the pause menu.
msgid "Quit"
msgstr ""

#. A button label to continue despite an error.
msgctxt "alert"
msgid "Continue"
msgstr ""

#. The title shown at the top of the pause menu.
msgid "Paused"
msgstr ""

#. A button to resume gameplay, located on the pause menu.
msgid "Resume"
msgstr ""

#. A button to return to the main menu, located on the pause menu.
msgid "Return to menu"
msgstr ""

#. The title of the confirmation dialog shown when quitting the game from the pause menu.
msgid "Quit game"
msgstr ""

#. The message shown in the confirmation dialog when quitting the game.
msgid "Are you sure you want to quit?"
msgstr ""

#. The title of the confirmation dialog shown when returning to the main menu from the pause menu.
msgid "Return to main menu"
msgstr ""

#. The message shown in the confirmation dialog when returning to the main menu.
msgid "Are you sure you want to return to the main menu?"
msgstr ""

#. Instructs the player to select which save slot to use.
msgid "Choose a save slot — progress will be saved automatically"
msgstr ""

#. A label for the timestamp of when the particular save was last updated.
msgid "Last updated:"
msgstr ""

#. A label displayed when a save slot is broken/unusable.
msgid "Broken"
msgstr ""

#. A label displayed when a save slot is empty/available/has no save data.
msgid "Empty"
msgstr ""

#. A button which the player can press to delete save data for a specific slot.
msgid "Delete"
msgstr ""

#. The title of the confirmation dialog shown when deleting a save slot.
msgid "Delete Save"
msgstr ""

#. The message shown in the confirmation dialog when deleting a save slot, warning the player that this action is permanent.
msgid "Are you sure? This cannot be undone."
msgstr ""

#. A button label to delete something (e.g. a save slot).
msgctxt "alert"
msgid "Delete"
msgstr ""

#. The title of the error dialog shown when deleting a save slot fails.
msgid "Delete Failed"
msgstr ""

#. The message shown when deleting a save slot fails.
msgid "The save slot could not be deleted."
msgstr ""

#. A tab within the game's options menu containing sound-related settings.
msgid "Sound"
msgstr ""

#. A tab within the game's options menu containing settings for interacting with the game. This menu includes things like text size, changing the game's display language, etc.
msgid "Interface"
msgstr ""

#. A tab within the game's options menu containing graphics/video-related settings.
msgid "Display"
msgstr ""

#. A tab within the game's options menu containing the controller's bindings and settings.
msgid "Controller"
msgstr ""

#. A tab within the game's options menu containing the keyboard and mouse's bindings and settings.
msgid "Keyboard & Mouse"
msgstr ""

#. A tab within the game's options menu containing accessibility settings, such as how the player performs actions which ask them to hold a button.
msgid "Accessibility"
msgstr ""

#. Used as a category name for a group of settings related to volume.
msgid "Volume"
msgstr ""

#. Describes the global volume setting within the options menu.
msgid "Global"
msgstr ""

#. Describes the sound effects volume setting within the options menu.
msgid "Sound Effects"
msgstr ""

#. Describes the musics volume setting within the options menu.
msgid "Music"
msgstr ""

#. Describes the spoken word volume setting within the options menu.
msgid "Voice"
msgstr ""

#. Used as a category name for a group of settings related to audio output.
msgid "Audio"
msgstr ""

#. Describes the setting which changes the specific audio output device used by the game.
msgid "Audio output device"
msgstr ""

#. Describes the setting which causes sound to be muted when the game is unfocused (i.e. when the user "tabs out" of the game).
msgid "Mute in background"
msgstr ""

#. Used as a category name for a group of settings related to display language.
msgid "Language"
msgstr ""

#. Describes the setting which changes the display language of the game.
msgid "Display language"
msgstr ""

#. Used as a category name for a group of settings related to text display.
msgid "Text"
msgstr ""

#. Describes the setting which changes the size of the text.
msgid "Scale text size"
msgstr ""

#. Used as a category name for a group of settings related to graphics.
msgid "Video"
msgstr ""

#. Describes the setting which toggles the size of the game between "windowed" and "fullscreen".
msgid "Fullscreen"
msgstr ""

#. Describes the setting which removes the border around the game application window.
msgid "Borderless"
msgstr ""

#. Describes the setting which adjusts the maximum number of frames drawn per second.
msgid "Max frame limit"
msgstr ""

#. Describes the setting which adjusts whether the game's frames drawn per second are capped to the monitor's refresh rate.
msgid "VSync"
msgstr ""

#. Used as a category name for gamepad settings.
msgid "Gamepads"
msgstr ""

#. Describes the setting used to change which gamepad type a visual gamepad button icon uses.
msgid "Button prompts"
msgstr ""

#. Describes one possible option in the button prompt setting; allows the game to automatically pick the best option.
msgctxt "button_prompt"
msgid "Auto"
msgstr ""

#. Describes one possible option in the button prompt setting; fixes gamepad icons to use the keyboard and mouse style.
msgctxt "button_prompt"
msgid "KB&M"
msgstr ""

#. Describes one possible option in the button prompt setting; fixes gamepad icons to use the style of the connected controller.
msgctxt "button_prompt"
msgid "Controller"
msgstr ""

#. Describes one possible option in the button prompt setting; fixes gamepad icons to use an Microsoft Xbox style.
msgctxt "button_prompt"
msgid "Xbox"
msgstr ""

#. Describes one possible option in the button prompt setting; fixes gamepad icons to use a Sony PlayStation style.
msgctxt "button_prompt"
msgid "PlayStation"
msgstr ""

#. Describes one possible option in the button prompt setting; fixes gamepad icons to use a Nintendo Switch style.
msgctxt "button_prompt"
msgid "Switch"
msgstr ""

#. Describes one possible option in the button prompt setting; fixes gamepad icons to use a Valve Steam style.
msgctxt "button_prompt"
msgid "Steam"
msgstr ""

#. Describes the setting which disables controller vibration feedback.
msgid "Disable vibration"
msgstr ""

#. Describes the setting which controls how intense controller vibration feedback is.
msgid "Vibration strength"
msgstr ""

#. Used as a category name for a group of settings related to Steam Input. Steam Input is a software library/interface for the Steam game distribution platform.
msgid "Steam Input"
msgstr ""

#. Describes a setting which adjusts the action-to-button bindings for a game controller.
msgid "Controller layout"
msgstr ""

#. Tells the user to connect a game controller, since its bindings can't be changed while none is connected.
msgid "Connect a controller to change its bindings."
msgstr ""

#. Used as a category name for mouse settings.
msgid "Mouse"
msgstr ""

#. Describes the setting which keeps the mouse cursor inside the game's window.
msgid "Confine cursor"
msgstr ""

#. Shown in place of a key or button in the controls settings, for an action with nothing bound at that slot.
msgid "--"
msgstr ""

#. Used as a category name for settings about actions which ask the player to hold a button down.
msgid "Holds"
msgstr ""

#. Describes the setting which changes how the player performs actions which ask them to hold a button down.
msgid "Hold actions"
msgstr ""

#. Describes one possible option in the hold action setting; each action works the way the game designed it.
msgctxt "hold_mode"
msgid "Game default"
msgstr ""

#. Describes one possible option in the hold action setting; the player holds the button down until the action completes.
msgctxt "hold_mode"
msgid "Hold"
msgstr ""

#. Describes one possible option in the hold action setting; the player taps the button once and the action completes on its own, unless they tap again to cancel it.
msgctxt "hold_mode"
msgid "Tap to toggle"
msgstr ""

#. Instructs the user that they will be updating the binding for the specified action. Here, the '{action}' placeholder will be replaced with the translated name of the game action.
msgid "Bind “{action}”"
msgstr ""

#. Instructs the user that they should now press the new keyboard key or exit the operation. Here, the '{origin}' placeholder will be replaced with an icon of the key to press.
msgctxt "keyboard"
msgid "Press any key now or {origin} to cancel."
msgstr ""

#. Instructs the user that they should now press the new controller button or exit the operation. Here, the '{origin}' placeholder will be replaced with an icon of the controller button to press.
msgctxt "gamepad"
msgid "Press any button now or {origin} to cancel."
msgstr ""

#. The name assistive technology reads for a button which performs a game action. Here, the '{origin}' placeholder will be replaced with the name of the key or controller button bound to the action, and '{action}' with the translated name of the action.
msgid "{origin}, {action}"
msgstr ""

#. The text of a button which performs a game action the player must hold the button down to confirm. Here, the '{action}' placeholder will be replaced with the translated name of the action.
msgid "Hold to {action}"
msgstr ""

#. The text of a button while a game action the player tapped is running on its own; tapping the button again cancels the action.
msgctxt "hold"
msgid "Cancel"
msgstr ""

